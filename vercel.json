{
  "functions": {
    "index.php": {
      "runtime": "vercel-php@0.9.0"
    },
    "api/*.php": {
      "runtime": "vercel-php@0.9.0"
    },
    "php/*.php": {
      "runtime": "vercel-php@0.9.0"
    },
    "php/etapes/*.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "rewrites": [
    { "source": "/", "destination": "/index.php" }
  ]
}
