{
  "runtime": "php:8.3",
  "functions": {
    "api/**/*.php": {
      "runtime": "php:8.3"
    }
  },
  "builds": [
    {
      "src": "api/**/*.php",
      "use": "@vercelphp/php"
    },
    {
      "src": "public/**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*).php",
      "dest": "/api/$1.php"
    },
    {
      "src": "/(.*)",
      "dest": "/public/$1"
    }
  ]
}
